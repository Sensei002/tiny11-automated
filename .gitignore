# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.env

# ISOs and Images (Large Files)
*.iso
*.wim
*.esd
*.vhd
*.vhdx
*.swm

# Build Artifacts & Logs
Tiny11*/
Win11_Source.iso
scripts/tiny11-core.iso
scripts/tiny11.iso
scripts/nano11.iso
*.log
*.tmp

# Checksums and Verification Files (generated artifacts)
*.sha256
*.md5
# Ignore all txt files except requirements.txt
*.txt
!requirements.txt

# OS Generated
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors
.vscode/
.idea/
*.swp

# Assistant/agent workspace.
# Holds local scratch scripts, CI job logs and machine-specific notes. Never
# belongs in a public repo -- may contain paths, hostnames or credentials.
.workbuddy-ai/

# SourceForge / FileZilla credentials and client state. The real FileZilla
# config lives in %APPDATA%\FileZilla (outside this repo), but ignore any
# stray copies so a password can never be committed.
sitemanager.xml
recentservers.xml
filezilla.xml

  "bcd": [
    {
      "args": "/set hypervisorlaunchtype off",
      "group": "disable_security_mitigations",
      "note": "Required for the VBS/HVCI-off path; also removes Hyper-V scheduler overhead."
    },
    {
      "args": "/set useplatformclock false",
      "note": "Prefer the invariant TSC over the platform clock."
    },
    {
      "args": "/set disabledynamictick yes",
      "group": "disable_cpu_idle",
      "note": "Keep the system timer running at a constant rate instead of going tickless while idle. Mild consistency gain, real idle-power cost - hence the group."
    },
    {
      "args": "/deletevalue useplatformtick",
      "ignoreFailure": true,
      "note": "REMOVED FROM THE PROFILE. Earlier revisions set 'useplatformtick yes', which forces the platform timer (HPET-class) as the tick source. That makes every timer read more expensive than the invariant TSC and can raise DPC cost, so it is deleted if an older image left it behind. 'not present' is the normal outcome."
    },
    {
      "args": "/set timeout 5",
      "note": "Short boot menu."
    },
    {
      "args": "/set nx OptIn",
      "note": "Keep DEP enabled - this is not a security downgrade."
    }
  ]
}

{
  "schemaVersion": "1.0.0",
  "profile": "core-gaming",
  "title": "Tiny11 Core-Gaming",
  "description": "Latency-first, AtlasOS-style profile for competitive esports on older hardware. Layers on top of the Tiny11 Core aggressive performance profile.",
  "hivePrefixes": {
    "SYSTEM": "HKLM\\zSYSTEM",
    "SOFTWARE": "HKLM\\zSOFTWARE",
    "DEFAULT": "HKLM\\zDEFAULT",
    "NTUSER": "HKLM\\zNTUSER"
  },
  "defaultGroups": {
    "atlas_power_scheme": true,
    "disable_cpu_idle": true,
    "disable_security_mitigations": true,
    "remove_xbox_gaming_stack": true,
    "strip_background_noise": true,
    "instant_windows": true,
    "disable_fast_startup": true,
    "network_latency_tweaks": true,
    "disable_mpo": true,
    "latency_input_tweaks": true,
    "interrupt_latency": true,
    "disable_fso": true,
    "disable_game_mode": true,
    "disable_printing": true
  },
  "groupDescriptions": {
    "atlas_power_scheme": "Custom AtlasOS-style power scheme, imported and activated at first boot.",
    "disable_cpu_idle": "Force CPU to C-State 0 (no idle) to remove C-State wake latency.",
    "disable_security_mitigations": "Turn off VBS, HVCI, Credential Guard, System Guard and Spectre/Meltdown mitigations.",
    "remove_xbox_gaming_stack": "Remove Xbox Live / Gaming Services stack and Xbox AppX packages.",
    "strip_background_noise": "Disable Windows Search indexing, Bluetooth, Delivery Optimization, background apps, visual effects and scripted diagnostics, and turn off memory compression on machines with 16 GB or more.",
    "instant_windows": "Remove window/menu/hover animations and shell delays, and shorten the app-close timeouts so windows open and close as fast as the hardware allows.",
    "disable_fast_startup": "Disable hibernation and Fast Startup (Hiberboot).",
    "network_latency_tweaks": "Disable Nagle, QoS reserved bandwidth, Delivery Optimization P2P and WU auto-reboot.",
    "disable_mpo": "Disable Multi-Plane Overlay to remove flicker / micro-stutter on some GPUs.",
    "latency_input_tweaks": "Disable mouse acceleration, accessibility hotkeys, USB 3 link power management and other USB/GPU latency contributors.",
    "interrupt_latency": "Per-device work that only exists on a live OS: MSI interrupts with high priority, NIC interrupt moderation off, RSS on, and USB/HID power management off.",
    "disable_fso": "Force true fullscreen exclusive instead of Fullscreen Optimizations.",
    "disable_game_mode": "Disable Windows Game Mode (AtlasOS default).",
    "disable_printing": "Disable print spooler services and remove the printing optional features."
  },
  "registry": [
    {
      "group": "disable_game_mode",
      "hive": "NTUSER",
      "path": "SOFTWARE\\Microsoft\\GameBar",
      "name": "AllowAutoGameMode",
      "type": "REG_DWORD",
      "value": "0",
      "note": "AtlasOS ships Game Mode off - its useful work is already done by disabling WU/telemetry/background apps."
    },
    {
      "group": "disable_game_mode",
      "hive": "NTUSER",
      "path": "SOFTWARE\\Microsoft\\GameBar",
      "name": "AutoGameModeEnabled",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "group": "disable_game_mode",
      "hive": "NTUSER",
      "path": "SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\GameDVR",
      "name": "AppCaptureEnabled",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "group": "disable_game_mode",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\GameDVR",
      "name": "AllowGameDVR",
      "type": "REG_DWORD",
      "value": "0"
    },
    {

    {
      "group": "instant_windows",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "name": "Start_TrackDocs",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Stop the shell maintaining a recent-documents list."
    },
    {
      "group": "instant_windows",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
      "name": "EnableTransparency",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Windows 11 acrylic/blur effects cost work on every window draw."
    },
    {
      "group": "instant_windows",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\Dwm",
      "name": "EnableAeroPeek",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "group": "instant_windows",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Control",
      "name": "WaitToKillServiceTimeout",
      "type": "REG_SZ",
      "value": "2000",
      "note": "Default 5000 ms. Service equivalent of WaitToKillAppTimeout."
    }
  ],

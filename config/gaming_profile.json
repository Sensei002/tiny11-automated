      "path": "System\\GameConfigStore",
      "name": "GameDVR_FSEBehavior",
      "type": "REG_DWORD",
      "value": "2",
      "note": "2 = force fullscreen exclusive, bypassing Fullscreen Optimizations."
    },
    {
      "group": "disable_fso",
      "hive": "NTUSER",
      "path": "System\\GameConfigStore",
      "name": "GameDVR_FSEBehaviorMode",
      "type": "REG_DWORD",
      "value": "2"
    },
    {
      "group": "disable_fso",
      "hive": "NTUSER",
      "path": "System\\GameConfigStore",
      "name": "GameDVR_HonorUserFSEBehaviorMode",
      "type": "REG_DWORD",
      "value": "1"
    },
    {
      "group": "disable_fso",
      "hive": "NTUSER",
      "path": "System\\GameConfigStore",
      "name": "GameDVR_DXGIHonorFSEWindowsCompatible",
      "type": "REG_DWORD",
      "value": "1"
    },
    {
      "group": "disable_fso",
      "hive": "NTUSER",
      "path": "System\\GameConfigStore",
      "name": "GameDVR_EFSEBehaviorMode",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "group": "disable_security_mitigations",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Control\\DeviceGuard",
      "name": "EnableVirtualizationBasedSecurity",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Largest remaining FPS lever on CPU-bound titles. Removes a kernel exploit mitigation."
    },
    {
      "group": "disable_security_mitigations",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Control\\DeviceGuard",
      "name": "RequirePlatformSecurityFeatures",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "group": "disable_security_mitigations",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Control\\DeviceGuard\\Scenarios\\HypervisorEnforcedCodeIntegrity",
      "name": "Enabled",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Memory Integrity / HVCI."
    },
    {
      "group": "disable_security_mitigations",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Control\\DeviceGuard\\Scenarios\\CredentialGuard",
      "name": "Enabled",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "group": "disable_security_mitigations",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Control\\DeviceGuard\\Scenarios\\SystemGuard",
      "name": "Enabled",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "group": "disable_security_mitigations",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\DeviceGuard",
      "name": "EnableVirtualizationBasedSecurity",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "group": "disable_security_mitigations",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\DeviceGuard",
      "name": "LsaCfgFlags",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "group": "disable_security_mitigations",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\DeviceGuard",
      "name": "HypervisorEnforcedCodeIntegrity",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "group": "disable_security_mitigations",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Control\\Session Manager\\Memory Management",
      "name": "FeatureSettingsOverride",
      "type": "REG_DWORD",
      "value": "3",
      "note": "3 = disable Spectre/Meltdown kernel mitigations."
    },
    {
      "group": "disable_security_mitigations",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Control\\Session Manager\\Memory Management",
      "name": "FeatureSettingsOverrideMask",
      "type": "REG_DWORD",
      "value": "3"
    },
    {
      "group": "atlas_power_scheme",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Control\\Power\\PowerThrottling",
      "name": "PowerThrottlingOff",
      "type": "REG_DWORD",
      "value": "1"
    },
    {
      "group": "atlas_power_scheme",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Control\\Power",
      "name": "HibernateEnabled",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "group": "atlas_power_scheme",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Control\\Power",
      "name": "HibernateEnabledDefault",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "group": "atlas_power_scheme",
      "hive": "SOFTWARE",
      "path": "Microsoft\\Windows NT\\CurrentVersion\\Multimedia\\SystemProfile",
      "name": "SystemResponsiveness",
      "type": "REG_DWORD",
      "value": "10",
      "note": "AtlasOS value. Tiny11 Core ships 0; 10 leaves a small CPU reserve for the rest of the system."
    },
    {
      "group": "disable_fast_startup",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Control\\Session Manager\\Power",
      "name": "HiberbootEnabled",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "group": "disable_mpo",
      "hive": "SOFTWARE",
      "path": "Microsoft\\Windows\\Dwm",
      "name": "OverlayTestMode",
      "type": "REG_DWORD",
      "value": "5",
      "note": "Disables Multi-Plane Overlay. Fixes flicker / micro-stutter on some NVIDIA and AMD drivers."
    },
    {
      "group": "latency_input_tweaks",
      "hive": "NTUSER",
      "path": "Control Panel\\Mouse",
      "name": "MouseSpeed",
      "type": "REG_SZ",
      "value": "0",
      "note": "Disable mouse acceleration - raw input for competitive shooters."
    },
    {
      "group": "latency_input_tweaks",
      "hive": "NTUSER",
      "path": "Control Panel\\Mouse",
      "name": "MouseThreshold1",
      "type": "REG_SZ",
      "value": "0"
    },
    {
      "group": "latency_input_tweaks",
      "hive": "NTUSER",
      "path": "Control Panel\\Mouse",
      "name": "MouseThreshold2",
      "type": "REG_SZ",
      "value": "0"
    },
    {
      "group": "latency_input_tweaks",
      "hive": "NTUSER",
      "path": "Control Panel\\Accessibility\\StickyKeys",
      "name": "Flags",
      "type": "REG_SZ",
      "value": "506",
      "note": "Stop the Shift-key Sticky Keys prompt from interrupting a match."
    },
    {
      "group": "latency_input_tweaks",
      "hive": "NTUSER",
      "path": "Control Panel\\Accessibility\\Keyboard Response",
      "name": "Flags",
      "type": "REG_SZ",
      "value": "122"
    },
    {
      "group": "latency_input_tweaks",
      "hive": "NTUSER",
      "path": "Control Panel\\Accessibility\\ToggleKeys",
      "name": "Flags",
      "type": "REG_SZ",
      "value": "58"
    },
    {
      "group": "latency_input_tweaks",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\DirectX\\UserGpuPreferences",
      "name": "DirectXUserGlobalSettings",
      "type": "REG_SZ",
      "value": "SwapEffectUpgradeEnable=1;VRROptimizeEnable=1",
      "note": "DXGI flip model / Optimizations for windowed games, with VRR optimisation ON. VRROptimizeEnable was 0 in an earlier revision, which told DWM not to align presentation to the display's refresh window - the opposite of what a VRR panel wants for frame pacing."
    },
    {
      "group": "network_latency_tweaks",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Services\\Tcpip\\Parameters",
      "name": "TcpAckFrequency",
      "type": "REG_DWORD",
      "value": "1",
      "note": "Global default. Per-adapter values are applied at first boot."
    },
    {
      "group": "network_latency_tweaks",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Services\\Tcpip\\Parameters",
      "name": "TCPNoDelay",
      "type": "REG_DWORD",
      "value": "1",
      "note": "Disables Nagle's algorithm."
    },
    {
      "group": "network_latency_tweaks",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Services\\Tcpip\\Parameters",
      "name": "TCPDelAckTicks",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "group": "network_latency_tweaks",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Services\\Tcpip\\Parameters",
      "name": "TcpMaxDataRetransmissions",
      "type": "REG_DWORD",
      "value": "5"
    },
    {
      "group": "network_latency_tweaks",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\Psched",
      "name": "NonBestEffortLimit",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Free the ~20% of bandwidth the QoS packet scheduler reserves."
    },
    {
      "group": "network_latency_tweaks",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\DeliveryOptimization",
      "name": "DODownloadMode",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Stop Delivery Optimization seeding updates to other PCs mid-game."
    },
    {
      "group": "network_latency_tweaks",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\WindowsUpdate\\AU",
      "name": "NoAutoRebootWithLoggedOnUsers",
      "type": "REG_DWORD",
      "value": "1",
      "note": "Never auto-reboot out from under a session."
    },
    {
      "group": "strip_background_noise",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\BackgroundAccessApplications",
      "name": "GlobalUserDisabled",
      "type": "REG_DWORD",
      "value": "1"
    },
    {
      "group": "strip_background_noise",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\AppPrivacy",
      "name": "LetAppsRunInBackground",
      "type": "REG_DWORD",
      "value": "2",
      "note": "2 = force deny."
    },
    {
      "group": "strip_background_noise",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VisualEffects",
      "name": "VisualFXSetting",
      "type": "REG_DWORD",
      "value": "2",
      "note": "2 = best performance. AtlasOS default."
    },
    {
      "group": "strip_background_noise",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\ScriptedDiagnostics",
      "name": "EnableDiagnostics",
      "type": "REG_DWORD",
      "value": "0",
      "note": "AtlasOS disables troubleshooting so it cannot reset tweaks."
    },
    {
      "group": "strip_background_noise",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\WDI",
      "name": "ScenarioExecutionEnabled",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "group": "instant_windows",
      "hive": "NTUSER",
      "path": "Control Panel\\Desktop\\WindowMetrics",
      "name": "MinAnimate",
      "type": "REG_SZ",
      "value": "0",
      "note": "The actual minimize/maximize animation toggle. VisualFXSetting alone does not reliably override this."
    },
    {
      "group": "instant_windows",
      "hive": "NTUSER",
      "path": "Control Panel\\Desktop",
      "name": "MenuShowDelay",
      "type": "REG_SZ",
      "value": "0",
      "note": "Windows default is 400 ms before a menu appears. This is the most noticeable shell delay."
    },
    {
      "group": "instant_windows",
      "hive": "NTUSER",
      "path": "Control Panel\\Desktop",
      "name": "AutoEndTasks",
      "type": "REG_SZ",
      "value": "1",
      "note": "End hung tasks automatically instead of waiting for a prompt."
    },
    {
      "group": "instant_windows",
      "hive": "NTUSER",
      "path": "Control Panel\\Desktop",
      "name": "HungAppTimeout",
      "type": "REG_SZ",
      "value": "1000",
      "note": "Default 5000 ms. How long a window is allowed to hang before Windows considers it unresponsive."
    },
    {
      "group": "instant_windows",
      "hive": "NTUSER",
      "path": "Control Panel\\Desktop",
      "name": "WaitToKillAppTimeout",
      "type": "REG_SZ",
      "value": "2000",
      "note": "Default 20000 ms. This is the 'window closing' latency: how long a slow app may linger on exit."
    },
    {
      "group": "instant_windows",
      "hive": "NTUSER",
      "path": "Control Panel\\Mouse",
      "name": "MouseHoverTime",
      "type": "REG_SZ",
      "value": "0",
      "note": "Default 400 ms hover delay."
    },
    {
      "group": "instant_windows",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "name": "TaskbarAnimations",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "group": "instant_windows",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "name": "ListviewAlphaSelect",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Removes the selection fade in Explorer."
    },
    {
      "group": "instant_windows",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "name": "ListviewShadow",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Removes the drop shadow behind icon labels."
    },
    {
      "group": "instant_windows",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "name": "ExtendedUIHoverTime",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Default 400 ms taskbar thumbnail hover delay."
    },
    {
      "group": "instant_windows",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "name": "ThumbnailLivePreviewHoverTime",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Default 400 ms live-preview hover delay."
    },
    {
      "group": "instant_windows",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "name": "DisallowShaking",
      "type": "REG_DWORD",
      "value": "1",
      "note": "Disables Aero Shake (shaking a window minimizes everything else)."
    },
    {
      "group": "instant_windows",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "name": "Start_TrackProgs",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Stop the shell maintaining a most-used-programs list on every launch."

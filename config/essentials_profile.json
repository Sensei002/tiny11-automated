{
  "profile": "tiny11-essentials",
  "schemaVersion": 1,
  "description": "The post-install debloat pass, baked into the image. Every entry names the checkbox it implements so the file can be audited against the source list item by item. Applied only on a Core-Gaming build, and always on - there is no group toggle.",
  "source": "Essential Tweaks + Advanced Tweaks, checked items only (17 + 3). The Customize Preferences column is cosmetic and is deliberately not implemented here.",
  "hivePrefixes": {
    "SYSTEM": "HKLM\\zSYSTEM",
    "SOFTWARE": "HKLM\\zSOFTWARE",
    "DEFAULT": "HKLM\\zDEFAULT",
    "NTUSER": "HKLM\\zNTUSER"
  },
  "registry": [
    {
      "item": "Activity History - Disable",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\System",
      "name": "EnableActivityFeed",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Stops the timeline from recording app/ document usage."
    },
    {
      "item": "Activity History - Disable",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\System",
      "name": "PublishUserActivities",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "item": "Activity History - Disable",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\System",
      "name": "UploadUserActivities",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "item": "BitLocker - Disable",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Control\\BitLocker",
      "name": "PreventDeviceEncryption",
      "type": "REG_DWORD",
      "value": "1",
      "note": "Blocks the automatic device encryption that 24H2 turns on by itself on modern hardware. The service is disabled separately, in services."
    },
    {
      "item": "Delivery Optimization - Disable",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\DeliveryOptimization",
      "name": "DODownloadMode",
      "type": "REG_DWORD",
      "value": "0",
      "note": "0 = HTTP only, no peer-to-peer. No background uploader process."
    },
    {
      "item": "Delivery Optimization - Disable",
      "hive": "SOFTWARE",
      "path": "Microsoft\\Windows\\CurrentVersion\\DeliveryOptimization\\Config",
      "name": "DODownloadMode",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "item": "End Task With Right Click - Enable",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "name": "TaskbarEndTask",
      "type": "REG_DWORD",
      "value": "1",
      "note": "Adds 'End task' to the taskbar context menu (23H2+)."
    },
    {
      "item": "File Explorer Automatic Folder Discovery - Disable",
      "hive": "NTUSER",
      "path": "Software\\Classes\\Local Settings\\Software\\Microsoft\\Windows\\Shell\\Bags\\AllFolders\\Shell",
      "name": "FolderType",
      "type": "REG_SZ",
      "value": "NotSpecified",
      "note": "Stops Explorer re-guessing a folder's type and applying Pictures/Music view templates."
    },
    {
      "item": "Hibernation - Disable",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Control\\Power",
      "name": "HibernateEnabled",
      "type": "REG_DWORD",
      "value": "0",
      "note": "The registry half. 'powercfg -h off' at first boot deletes hiberfil.sys and is the half that actually reclaims the disk space."
    },
    {
      "item": "Hibernation - Disable",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Control\\Power",
      "name": "HibernateEnabledDefault",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "item": "Location Tracking - Disable",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\LocationAndSensors",
      "name": "DisableLocation",
      "type": "REG_DWORD",
      "value": "1"
    },
    {
      "item": "Location Tracking - Disable",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\LocationAndSensors",
      "name": "DisableLocationScripting",
      "type": "REG_DWORD",
      "value": "1"
    },
    {
      "item": "Location Tracking - Disable",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\LocationAndSensors",
      "name": "DisableWindowsLocationProvider",
      "type": "REG_DWORD",
      "value": "1"
    },
    {
      "item": "Microsoft Store Recommended Search Results - Disable",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
      "name": "SystemPaneSuggestionsEnabled",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Store app suggestions in search and the Start menu."
    },
    {
      "item": "Microsoft Store Recommended Search Results - Disable",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
      "name": "SilentInstalledAppsEnabled",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Stops Windows quietly installing 'suggested' Store apps after logon."
    },
    {
      "item": "Microsoft Store Recommended Search Results - Disable",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
      "name": "PreInstalledAppsEnabled",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "item": "Microsoft Store Recommended Search Results - Disable",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
      "name": "OemPreInstalledAppsEnabled",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "item": "Microsoft Store Recommended Search Results - Disable",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
      "name": "SubscribedContent-338388Enabled",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Start menu suggestions."
    },
    {
      "item": "Microsoft Store Recommended Search Results - Disable",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
      "name": "SubscribedContent-338389Enabled",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Tips and 'Get more out of Windows'."
    },
    {
      "item": "Microsoft Store Recommended Search Results - Disable",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
      "name": "SubscribedContent-338393Enabled",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "item": "Microsoft Store Recommended Search Results - Disable",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
      "name": "SubscribedContent-353694Enabled",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "item": "Microsoft Store Recommended Search Results - Disable",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\ContentDeliveryManager",
      "name": "SubscribedContent-353696Enabled",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "item": "Prevent Device Companion Apps",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\Appx",
      "name": "PreventDeviceCompanionAppInstall",
      "type": "REG_DWORD",
      "value": "1",
      "note": "Stops the Store auto-installing a vendor companion app the moment a peripheral is plugged in."
    },
    {
      "item": "Start Menu Previous Layout - Enable",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "name": "Start_Layout",
      "type": "REG_DWORD",
      "value": "1",
      "note": "All-apps-first layout with no recommendation feed."
    },
    {
      "item": "Telemetry - Disable",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\DataCollection",
      "name": "DoNotShowFeedbackNotifications",
      "type": "REG_DWORD",
      "value": "1",
      "note": "AllowTelemetry itself is already set by the Core registry pass; these are the values Core does not cover."
    },
    {
      "item": "Telemetry - Disable",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\DataCollection",
      "name": "AllowDeviceNameInTelemetry",
      "type": "REG_DWORD",
      "value": "0"
    },
    {
      "item": "Widgets - Remove",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Dsh",
      "name": "AllowNewsAndInterests",
      "type": "REG_DWORD",
      "value": "0",
      "note": "The widgets board. The WebExperience package that hosts it is already removed by the Core bloatware pass."
    },
    {
      "item": "Widgets - Remove",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "name": "TaskbarDa",
      "type": "REG_DWORD",
      "value": "0",
      "note": "Removes the widgets button from the taskbar."
    },
    {
      "item": "Windows Platform Binary Table (WPBT) - Disable",
      "hive": "SYSTEM",
      "path": "ControlSet001\\Control\\Session Manager",
      "name": "DisableWpbtExecution",
      "type": "REG_DWORD",
      "value": "1",
      "note": "WPBT lets firmware drop an executable into Windows at every boot. Nothing a gaming box needs."
    },
    {
      "item": "Microsoft OneDrive - Remove",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\OneDrive",
      "name": "DisableFileSyncNGSC",
      "type": "REG_DWORD",
      "value": "1",
      "note": "Blocks OneDrive sync. The OneDriveSetup binaries are already deleted by the Core build."
    },
    {
      "item": "Right-Click Menu Previous Layout - Enable",
      "hive": "NTUSER",
      "path": "Software\\Classes\\CLSID\\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\\InprocServer32",
      "name": "",
      "type": "REG_SZ",
      "value": "",
      "note": "Empty default value = the shell falls back to the Windows 10 context menu. Removing this key restores the Windows 11 one."
    },
    {
      "item": "Windows AI - Disable And Remove",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\WindowsAI",
      "name": "DisableAIDataAnalysis",
      "type": "REG_DWORD",
      "value": "1",
      "note": "Recall / Click to Do analysis. The AI and Copilot packages are already in the Core bloatware removal list."
    },
    {
      "item": "Windows AI - Disable And Remove",
      "hive": "SOFTWARE",
      "path": "Policies\\Microsoft\\Windows\\WindowsAI",
      "name": "AllowRecallEnablement",
      "type": "REG_DWORD",
      "value": "0"
    }
  ],
  "deleteKeys": [
    {
      "item": "Microsoft OneDrive - Remove",
      "hive": "NTUSER",
      "path": "Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Desktop\\NameSpace\\{018D5C66-4533-4307-9B53-224DE2ED1FE6}",
      "note": "The OneDrive entry in the Explorer navigation pane. A key, not a value, so it cannot be expressed as a registry entry."
    }
  ],

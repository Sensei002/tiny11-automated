  "handledElsewhere": [
    {
      "item": "ConsumerFeatures - Disable",
      "by": "core",
      "where": "Apply-RegistryTweaks in tiny11coremaker-headless.ps1",
      "evidence": "SOFTWARE\\Policies\\Microsoft\\Windows\\CloudContent\\DisableWindowsConsumerFeatures = 1, plus DisableConsumerAccountStateContent and DisableCloudOptimizedContent",
      "note": "Core sets this unconditionally for every image, so repeating it here would be two sources of truth that can drift."
    },
    {
      "item": "Temporary Files - Remove",
      "by": "firstBoot",
      "where": "firstBoot.cleanTemp in gaming-firstboot.ps1",
      "evidence": "clears %WINDIR%\\Temp and %TEMP% once, as SYSTEM, before the first logon",
      "note": "There is no populated %TEMP% inside install.wim - setup fills it while laying the image down, so this can only run on the target machine."
    },
    {
      "item": "Restore Point - Create",
      "by": "firstBoot",
      "where": "firstBoot.restorePoint in gaming-firstboot.ps1",
      "evidence": "Enable-ComputerRestore + Checkpoint-Computer, best-effort",
      "note": "Needs a running VSS and a real system volume."
    }
  ],
  "firstBoot": {
    "hibernateOff": true,
    "cleanTemp": true,
    "restorePoint": true,
    "restorePointDescription": "Tiny11 Core-Gaming baseline",
    "reportProcessCount": true
  },
  "notes": [
    "Every entry is applied unconditionally. There is no group flag and no workflow input for this layer - a Core-Gaming build always gets it.",
    "Core already covers ConsumerFeatures, Telemetry AllowTelemetry, background apps, visual effects, OneDrive Setup removal, Widgets/Copilot/AI packages and the WSearch/DiagTrack services. Those are not duplicated here; GAMING.md lists them as already-covered."
  ]
}
